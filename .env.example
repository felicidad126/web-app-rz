APP_NAME="Dental PMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
# Isi jika di balik reverse proxy/Cloudflare/load balancer (IP dipisah koma, atau *).
TRUSTED_PROXIES=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dental_pms
DB_USERNAME=dental
DB_PASSWORD=

SESSION_DRIVER=database
# Idle timeout (menit). Data medis: jaga tetap singkat.
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-3
AWS_ENDPOINT=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Klinik ---
# Kunci HMAC untuk blind index NIK (base64, 32 byte). WAJIB diisi & jangan pernah diganti setelah ada data.
# Generate: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
BLIND_INDEX_KEY=
CLINIC_RM_PREFIX=
CLINIC_RM_PAD=6
# Password akun DemoSeeder. Wajib diisi acak di staging yang bisa diakses publik.
DEMO_PASSWORD=

# --- Backup (spatie/laravel-backup) ---
# Disk tujuan backup. Produksi: "backup" (S3-compatible). Lokal: "local".
BACKUP_DISK=local
# Password enkripsi arsip backup (AES-256). WAJIB di produksi.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=ap-southeast-3
BACKUP_AWS_BUCKET=
BACKUP_AWS_ENDPOINT=
BACKUP_AWS_USE_PATH_STYLE_ENDPOINT=false
